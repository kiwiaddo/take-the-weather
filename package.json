{
  "name": "nz-weather",
  "version": "1.0.0",
  "private": true,
  "description": "NZ Weather Aggregator — Cloudflare Worker that pulls Open-Meteo data on a cron and serves it via a small API + frontend.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create nz-weather-db",
    "db:migrate:local": "wrangler d1 execute nz-weather-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute nz-weather-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.99.0"
  }
}
